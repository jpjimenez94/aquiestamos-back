# PostgreSQL (Railway → pestaña Variables del servicio Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/aqui_estamos"

# Puerto local (en Railway se inyecta automáticamente)
PORT=4000
NODE_ENV=development

# Orígenes autorizados para CORS, separados por coma
CORS_ORIGINS="http://localhost:3000,https://aqui-estamos.vercel.app"

# Duración de la sesión del portal, en horas
SESSION_TTL_HOURS=12

# Firma los enlaces de caso compartido. En produccion es obligatoria y debe ser
# larga y aleatoria: openssl rand -hex 32
SHARED_CASE_SECRET=
SHARED_CASE_TTL_HOURS=12

# Firma los enlaces de sala de videollamada. Obligatoria fuera de las pruebas:
# sin ella el backend no arranca, y es a proposito. Antes esta variable no
# existia y `meeting.service.js` firmaba con un literal escrito en el codigo,
# que esta publicado en GitHub: cualquiera podia fabricar una llave de sala
# valida y entrar a la sesion de una persona en terapia.
# Generala aparte de SHARED_CASE_SECRET: openssl rand -hex 32
MEETING_SECRET=

# Se aceptan todavia los enlaces viejos de sala, que son `/sala/<uuid-de-cita>`
# sin firma ninguna? Ponlo en false cuando ya no queden citas agendadas antes
# del cambio a enlaces firmados. Mientras siga en true, conocer el UUID de una
# cita basta para entrar a su sala.
SALA_ACEPTA_UUID=true

# Dominio de Jitsi de arranque. Manda `DOMINIO_JITSI` de Parametrizacion
# cuando esta configurado en la base; esto es solo el valor inicial.
JITSI_DOMAIN=meet.jit.si

# Primera cuenta de administrador (solo la usa `npm run db:seed-admin`).
# Si dejas la clave vacía, el script genera una aleatoria y la muestra una vez.
BOOTSTRAP_ADMIN_EMAIL="admin@aquiestamos.org"
BOOTSTRAP_ADMIN_NAME="Administración"
BOOTSTRAP_ADMIN_PASSWORD=""

# Opcional: prefijo absoluto para portadas y PDF de los recursos
# RESOURCE_ASSET_BASE="https://aqui-estamos.vercel.app"

# --- Envio de avisos por correo (Brevo) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=el-login-que-da-brevo@smtp-brevo.com
SMTP_PASSWORD=la-clave-smtp-generada-en-brevo
# Tiene que ser un remitente verificado en Brevo, si no rechaza el envio.
SMTP_FROM=Red Aqui Estamos <no-responder@redaquiestamos.org>
# A donde llegan los avisos internos. Vacio = a todas las cuentas ADMIN.
NOTIFICACIONES_COORDINACION=
# Los avisos llevan enlaces: en produccion, https://redaquiestamos.org
SITIO_URL=http://localhost:3000

# Envio por la API HTTPS de Brevo. Es lo que hay que usar en Railway: sus
# planes Free, Trial y Hobby bloquean el SMTP saliente. Es una clave DISTINTA
# de la SMTP y empieza por xkeysib-. Si esta puesta, se usa esta y no SMTP.
BREVO_API_KEY=

# Dias que se espera la respuesta al tamizaje antes de admitir igual, con
# prioridad MEDIA. Sin esto, quien pide ayuda y no abre el enlace no entra a
# ninguna cola. El servidor lo revisa solo cada hora.
ADMISION_AUTOMATICA_DIAS=2

# Liberación automática de asignaciones que se mueren de silencio. Si el
# profesional no responde la propuesta en estos días, el sistema cancela la
# asignación, libera su cupo y devuelve el caso a la cola de por asignar.
PROPUESTA_VENCE_DIAS=2
# Lo mismo si el profesional aceptó pero la persona nunca confirmó horario.
# Es más largo a propósito: quien pide ayuda puede estar sin batería o sin
# cabeza, y soltarle el acompañamiento rápido castiga a quien peor está.
ACEPTADA_VENCE_DIAS=3

# --- Documentos: tarjetas profesionales, certificados y consentimientos ---
# Bucket PRIVADO de Supabase Storage. La clave es la `service_role`, no la
# `anon`: es la unica que lee y escribe en un bucket privado, y por eso vive
# solo aqui y nunca llega al navegador. El portal recibe URLs firmadas que
# caducan en un minuto.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documentos
SUPABASE_FIRMA_SEGUNDOS=60
