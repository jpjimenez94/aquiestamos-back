# Entorno de PRUEBAS. `vitest.config.js` carga este archivo ANTES que `.env`,
# y dotenv no pisa lo que ya esté definido: por eso lo que se ponga aquí gana.
#
# Existe por una razón concreta. El 27 de agosto de 2026 una corrida de
# `npm test` borró 53 avisos de la bandeja de producción, porque `.env`
# apuntaba a Railway y el globalSetup hace `deleteMany({})` sin filtro.
# Mientras `.env` pueda apuntar a producción —y a veces tiene que poder—,
# las pruebas necesitan su propia base, dicha aquí y en ningún otro sitio.
#
# La guarda de `src/config/baseSegura.js` aborta la tanda si esto no es local.

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/aqui_estamos_test"

NODE_ENV=test

# Firma de enlaces. En pruebas basta con que sean estables y no vacías.
SHARED_CASE_SECRET="secreto-solo-para-pruebas"
MEETING_SECRET="secreto-de-sala-solo-para-pruebas"

# Sin SMTP ni Brevo: los avisos se encolan y se comprueban en la base, pero
# no sale un solo correo hacia el mundo.
SMTP_HOST=
BREVO_API_KEY=

# Sin Supabase: las pruebas de documentos comprueban el fallo ruidoso.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

SITIO_URL=http://localhost:3000
