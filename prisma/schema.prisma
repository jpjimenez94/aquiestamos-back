// ---------------------------------------------------------------------------
// Aquí Estamos — capa MODELO (M de MVC)
// Motor: PostgreSQL (Railway)
//
// Convenciones:
//   · Todas las fechas van en `timestamptz`: se guardan en UTC y se muestran en
//     America/Bogota. Una agenda con `timestamp` sin zona acaba con citas a la
//     hora equivocada en cuanto alguien viaja o el servidor cambia de región.
//   · Nada se borra en duro. `deletedAt` marca el registro como eliminado y una
//     política de retención decide cuándo se purga de verdad.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Acceso al portal
// ===========================================================================

/// Quién puede entrar y qué puede hacer. El detalle de cada permiso vive en
/// `src/auth/permissions.js`, no aquí.
enum UserRole {
  /// Administrador general: todo, incluido crear usuarios y ver la auditoría.
  ADMIN
  /// Voluntario digital: consulta y agenda citas. No edita datos maestros.
  AGENDADOR
  /// Admisión y Verificaciones: solo gestiona solicitudes, postulaciones y verificaciones.
  ADMISION
  /// Coordinador de Casos y Agenda: solo gestiona agenda, citas y personas acompañadas.
  COORDINADOR_CASOS
  /// Operador de líderes comunitarios y territorio.
  LIDERES_COMUNITARIOS
  /// Profesional de la red: solo consulta sus propias asignaciones.
  PROFESIONAL
  /// Solo lectura: ve todo, no toca nada. Para quien supervisa u observa.
  LECTURA
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(160)
  name               String    @db.VarChar(160)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  roles              UserRole[] @default([])
  active             Boolean   @default(true)
  /// Las cuentas las crea un administrador; la persona cambia la clave al entrar.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  sessions     Session[]
  auditLogs    AuditLog[]
  professional Professional?
  leaders      CommunityLeader[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Sesión abierta. Se guarda el hash del token, nunca el token: si se filtra la
/// base, lo robado no sirve para entrar.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  ip        String?   @db.VarChar(60)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rastro de lo que pasa con datos sensibles. Solo se inserta: nadie edita ni
/// borra filas de esta tabla.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Desnormalizado a propósito: el rastro debe seguir siendo legible aunque la
  /// cuenta que lo generó desaparezca.
  actorEmail String?  @map("actor_email") @db.VarChar(160)
  action     String   @db.VarChar(60)
  entity     String   @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ===========================================================================
// Formularios públicos (admisión)
// ===========================================================================

/// Años de ejercicio profesional
enum YearsExperience {
  MENOS_DE_1
  ENTRE_1_Y_3
  ENTRE_3_Y_5
  MAS_DE_5
}

/// Horas semanales que puede dedicar. Cada sesión son 45 minutos más 30 de descanso.
enum WeeklyHours {
  ENTRE_1_Y_3
  ENTRE_4_Y_6
  MAS_DE_6
  VARIABLE
}

/// Día de la semana en que hay disponibilidad
enum Weekday {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/// Franja del día. Mañana 8-12, tarde 12-18, noche 18-21 (hora de Bogotá).
enum DaySlot {
  MANANA
  TARDE
  NOCHE
}

/// Para quién se pide el acompañamiento
enum ForWhom {
  PARA_MI
  PARA_OTRA_PERSONA
}

/// Canal preferido de contacto
enum PreferredContact {
  WHATSAPP
  LLAMADA
  CORREO
}

/// Modalidad que prefiere quien solicita
enum PreferredModality {
  PRESENCIAL
  VIRTUAL
  INDIFERENTE
}

/// Experiencia previa en atención en crisis / primeros auxilios psicológicos
enum CrisisExperience {
  SI
  NO
  FORMACION_POCA_PRACTICA
  SIN_FORMACION_DISPONIBLE_APRENDER
}

/// Modalidad en la que puede brindar acompañamiento
enum Modality {
  PRESENCIAL
  VIRTUAL
  AMBAS
}

/// Estado de vacunación contra la fiebre amarilla
enum YellowFeverStatus {
  SI
  NO
  CITA_AGENDADA
}

/// Estado de la tarjeta profesional
enum ProfessionalCardStatus {
  SI
  EN_TRAMITE
  ESTUDIANTE
}

/// Estado interno del registro dentro del proceso de la red
enum SubmissionStatus {
  NUEVO
  EN_REVISION
  CONTACTADO
  ACTIVO
  DESCARTADO
}

/// Areas del voluntariado que no da acompanamiento psicologico.
/// Es un enum y no texto libre porque es con lo que se filtra el directorio.
enum CollaboratorArea {
  SALUD
  SOCIAL_LEGAL_EDUCATIVO
  OPERACION_LOGISTICA
  COMUNICACION_TECNOLOGIA
  GESTION_PROYECTOS
  OTRA
}

/// Estado de un aviso en la bandeja de salida.
enum NotificationStatus {
  PENDIENTE
  ENVIADA
  FALLIDA
}

/// Bandeja de salida de avisos.
///
/// Los correos NO se envían dentro de la petición. Si el proveedor tarda o
/// está caído, el formulario público le fallaría a la persona por algo que no
/// es culpa suya. Aquí el evento se guarda y responde de inmediato; un
/// despachador los envía aparte y reintenta lo que falle.
///
/// Además deja rastro de qué se le envió a quién, que con datos de salud de
/// por medio no es un lujo sino parte de habeas data.
///
/// Regla del contenido: un aviso NUNCA lleva datos identificatorios de una
/// persona acompañada. Lleva un enlace; quien tenga que ver los datos entra
/// por ahí y se identifica.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  /// Qué plantilla se usa. Es texto y no enum para poder añadir un aviso sin
  /// migrar la base.
  template String  @db.VarChar(60)
  toEmail  String  @map("to_email") @db.VarChar(160)
  toName   String? @map("to_name") @db.VarChar(160)
  subject  String  @db.VarChar(200)
  /// Lo que la plantilla necesita para armarse.
  payload  Json

  status    NotificationStatus @default(PENDIENTE)
  attempts  Int                @default(0)
  lastError String?            @map("last_error") @db.VarChar(500)
  /// No se intenta antes de esta hora. Es el reintento con espera creciente.
  sendAfter DateTime           @default(now()) @map("send_after") @db.Timestamptz(3)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(3)

  /// A qué se refiere, para poder rastrearlo desde el portal.
  entity   String? @db.VarChar(60)
  entityId String? @map("entity_id") @db.VarChar(60)

  /// Mismo evento y mismo destinatario, un solo envío. Es lo que evita que un
  /// reintento de la petición mande el correo dos veces.
  dedupeKey String @unique @map("dedupe_key") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, sendAfter])
  @@index([createdAt])
  @@map("notifications")
}

/// Profesional que se postula a la red ("Quiero ser parte").
/// Es el registro de lo que la persona envió: no se edita.
model Volunteer {
  id String @id @default(uuid()) @db.Uuid

  // --- Bloque 1: datos de contacto ---
  fullName String  @map("full_name") @db.VarChar(160)
  phone    String  @db.VarChar(40)
  email    String  @db.VarChar(160)
  /// Ciudad o municipio donde vive. Antes se llamaba `residence`.
  city     String? @db.VarChar(160)

  // --- Bloque 2: perfil profesional ---
  /// Profesion, en campo aparte para poder filtrar por ella.
  profession         String?                @db.VarChar(160)
  /// Especializaciones, maestrias o cursos. Texto libre.
  additionalTraining String?                @map("additional_training") @db.VarChar(400)
  yearsExperience    YearsExperience?       @map("years_experience")
  professionalCard   ProfessionalCardStatus @map("professional_card")
  populations        String[]               @map("populations")
  populationOther    String?                @map("population_other") @db.VarChar(200)
  crisisExperience   CrisisExperience       @map("crisis_experience")

  // --- Bloque 3: disponibilidad ---
  modality           Modality
  availableToTravel  String?            @map("available_to_travel") @db.VarChar(200)
  /// Que dias puede. Alimenta directamente las franjas de la agenda.
  availableDays      Weekday[]          @map("available_days")
  availableSlots     DaySlot[]          @map("available_slots")
  weeklyHours        WeeklyHours?       @map("weekly_hours")
  /// Solo se pregunta a quien puede acompanar de forma presencial.
  yellowFeverVaccine YellowFeverStatus? @map("yellow_fever_vaccine")

  // --- Bloque 4: autorizaciones ---
  /// Que version del texto de autorizacion acepto. Sin esto, una autorizacion
  /// no se puede probar cuando el texto cambie.
  consentVersion        String? @map("consent_version") @db.VarChar(20)
  dataConsent           Boolean @map("data_consent")
  /// Solo aplica si entrego el dato de vacunacion, que es dato de salud.
  sensitiveDataConsent  Boolean @default(false) @map("sensitive_data_consent")
  communicationsConsent Boolean @default(false) @map("communications_consent")

  // --- Heredados de la primera version del formulario ---
  /// @deprecated Sustituido por `profession` y `additionalTraining`.
  training     String?  @db.VarChar(300)
  /// @deprecated Sustituido por `city`.
  residence    String?  @db.VarChar(160)
  /// @deprecated Sustituido por `weeklyHours`.
  availability String[]

  status    SubmissionStatus @default(NUEVO)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("volunteers")
}

/// Persona que solicita acompañamiento ("Atención Psicológica").
/// Igual que la postulación: es el registro de lo enviado, no se edita.
model SupportRequest {
  id String @id @default(uuid()) @db.Uuid

  // --- Bloque 1: para quien es ---
  forWhom      ForWhom? @map("for_whom")
  /// Solo si es para otra persona. Cambia quien debe autorizar el tratamiento.
  isMinor      Boolean? @map("is_minor")
  /// Parentesco o relacion con la persona acompanada.
  relationship String?  @db.VarChar(120)
  /// Nombre de quien llena el formulario, cuando no es la persona acompanada.
  contactName  String?  @map("contact_name") @db.VarChar(160)

  // --- Bloque 2: contacto ---
  /// Nombre de la persona que recibira el acompanamiento.
  name             String            @db.VarChar(160)
  phone            String            @db.VarChar(40)
  /// Opcional a proposito: la red trabaja por WhatsApp y no todo el mundo
  /// tiene o revisa correo.
  email            String?           @db.VarChar(160)
  preferredContact PreferredContact? @map("preferred_contact")
  /// Ciudad o municipio. Antes se llamaba `place`.
  city             String?           @db.VarChar(160)

  // --- Bloque 3: cuando y como ---
  preferredModality PreferredModality? @map("preferred_modality")
  availableDays     Weekday[]          @map("available_days")
  availableSlots    DaySlot[]          @map("available_slots")
  message           String?            @db.VarChar(1000)

  // --- Bloque 4: autorizaciones ---
  consentVersion        String? @map("consent_version") @db.VarChar(20)
  dataConsent           Boolean @map("data_consent")
  sensitiveDataConsent  Boolean @default(false) @map("sensitive_data_consent")
  /// Obligatoria cuando la persona acompanada es menor de edad.
  guardianConsent       Boolean @default(false) @map("guardian_consent")
  communicationsConsent Boolean @default(false) @map("communications_consent")

  // --- Heredados de la primera version del formulario ---
  /// @deprecated Sustituido por `city`.
  place        String? @db.VarChar(160)
  /// @deprecated Sustituido por `availableDays` y `availableSlots`.
  availability String? @db.VarChar(300)

  status    SubmissionStatus @default(NUEVO)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)

  /// Lo que respondió en el tamizaje, si lo respondió.
  triageResponses TriageResponse[]

  @@index([createdAt])
  @@index([deletedAt])
  /// La bandeja se lee por estado: lo NUEVO primero, y dentro de eso lo más
  /// reciente. Sin este índice esa consulta ordena la tabla entera en memoria.
  @@index([status, createdAt])
  @@map("support_requests")
}

// ===========================================================================
// Biblioteca pública
// ===========================================================================

model ResourceCategory {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique @db.VarChar(120)
  name      String     @db.VarChar(160)
  position  Int        @default(0)
  resources Resource[]

  @@map("resource_categories")
}

model Resource {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(160)
  title       String    @db.VarChar(200)
  description String    @db.VarChar(600)
  collection  String    @default("Cuentos infantiles") @db.VarChar(120)
  coverImage  String    @map("cover_image") @db.VarChar(300)
  fileUrl     String    @map("file_url") @db.VarChar(500)
  fileName    String    @map("file_name") @db.VarChar(200)
  icon        String    @default("sparkle") @db.VarChar(60)
  position    Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  categoryId String           @map("category_id") @db.Uuid
  category   ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([deletedAt])
  @@map("resources")
}

// ===========================================================================
// Fase 1 — entidades operativas
//
// El registro del formulario es lo que la persona envió y no se edita nunca.
// Estas entidades nacen a partir de él y evolucionan por su cuenta: son las
// que el equipo administra.
// ===========================================================================

/// Estado operativo del profesional. Dice si PUEDE recibir casos; cuántos lleva
/// se calcula contando asignaciones activas, nunca se guarda en un campo.
enum ProfessionalStatus {
  PENDIENTE_VALIDACION
  ACTIVO
  PAUSADO
  INACTIVO
}

/// Urgencia con la que hay que buscarle profesional a alguien.
/// El orden de declaracion importa: ordenar por prioridad descendente pone
/// ALTA primero, que es como se lee la cola de pendientes.
enum CasePriority {
  BAJA
  MEDIA
  ALTA
}

enum PatientStatus {
  NUEVO
  EN_ADMISION
  ASIGNADO
  EN_ACOMPANAMIENTO
  CERRADO
}

/// Estados de la negociación de un caso. El detalle de qué transición es
/// válida vive en `src/services/assignmentState.service.js`, no aquí.
enum AssignmentStatus {
  /// Se le propuso al profesional y está esperando su respuesta.
  PROPUESTA
  /// Aceptó y dejó los horarios en los que puede.
  ACEPTADA
  /// Hay cita agendada: el acompañamiento va.
  ACTIVA
  /// El profesional no pudo. Terminal: se le propone a otro.
  RECHAZADA
  /// Aceptó, pero no se pudo cuadrar horario con la persona. Terminal.
  CANCELADA
  CERRADA
}

/// Voluntariado de otras disciplinas: quien apoya la respuesta sin dar
/// acompanamiento psicologico.
///
/// Va en tabla aparte de `Volunteer` a proposito. Una postulacion de
/// psicologia se aprueba y se convierte en `Professional`, que es a quien el
/// sistema le busca pacientes compatibles y le agenda citas. Un abogado o un
/// coordinador de logistica no entra en ese circuito: si compartieran tabla,
/// bastaria con olvidar un filtro en una consulta para que apareciera como
/// candidato para acompanar a alguien en crisis.
///
/// Esto es un directorio: se consulta y se llama. No tiene agenda.
model Collaborator {
  id String @id @default(uuid()) @db.Uuid

  // --- Bloque 1: contacto ---
  fullName String @map("full_name") @db.VarChar(160)
  phone    String @db.VarChar(40)
  email    String @db.VarChar(160)
  city     String @db.VarChar(160)

  // --- Bloque 2: que sabe hacer ---
  area             CollaboratorArea
  /// La disciplina concreta dentro del area. Es texto y no enum para poder
  /// anadir una sin migrar la base: el catalogo vive en el validador.
  discipline       String                  @db.VarChar(120)
  /// Que escribio si eligio "Otra".
  disciplineOther  String?                 @map("discipline_other") @db.VarChar(160)
  yearsExperience  YearsExperience?        @map("years_experience")
  /// Opcional: no todas las disciplinas tienen tarjeta profesional.
  professionalCard ProfessionalCardStatus? @map("professional_card")
  /// En que puede ayudar, con sus palabras. Es lo que mas sirve para decidir
  /// a quien llamar cuando aparece una necesidad concreta.
  skills           String?                 @db.VarChar(600)

  // --- Bloque 3: disponibilidad ---
  modality           Modality
  availableToTravel  String?            @map("available_to_travel") @db.VarChar(200)
  availableDays      Weekday[]          @map("available_days")
  availableSlots     DaySlot[]          @map("available_slots")
  weeklyHours        WeeklyHours?       @map("weekly_hours")
  /// Solo se pregunta a quien puede apoyar de forma presencial.
  yellowFeverVaccine YellowFeverStatus? @map("yellow_fever_vaccine")

  // --- Bloque 4: autorizaciones ---
  consentVersion        String? @map("consent_version") @db.VarChar(20)
  dataConsent           Boolean @map("data_consent")
  /// Solo aplica si entrego el dato de vacunacion, que es dato de salud.
  sensitiveDataConsent  Boolean @default(false) @map("sensitive_data_consent")
  communicationsConsent Boolean @default(false) @map("communications_consent")

  status    SubmissionStatus @default(ACTIVO)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)

  assignments TaskAssignment[]

  @@index([email])
  @@index([area])
  @@index([city])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("collaborators")
}

model Professional {
  id          String  @id @default(uuid()) @db.Uuid
  /// Cuenta con la que entra al portal, si ya la tiene.
  userId      String? @unique @map("user_id") @db.Uuid
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Postulación de la que nació. Se conserva como prueba de lo que declaró.
  volunteerId String? @unique @map("volunteer_id") @db.Uuid

  fullName String @map("full_name") @db.VarChar(160)
  email    String @db.VarChar(160)
  phone    String @db.VarChar(40)
  city     String @db.VarChar(160)

  profession                  String                  @db.VarChar(160)
  yearsExperience             YearsExperience?        @map("years_experience")
  professionalCard            ProfessionalCardStatus? @map("professional_card")
  professionalCardNumber      String?                 @map("professional_card_number") @db.VarChar(60)
  professionalCardDocumentUrl String?                 @map("professional_card_document_url") @db.VarChar(500)
  professionalCardVerified    Boolean                 @default(false) @map("professional_card_verified")
  professionalCardVerifiedAt  DateTime?               @map("professional_card_verified_at") @db.Timestamptz(3)
  professionalCardVerifiedBy  String?                 @map("professional_card_verified_by") @db.VarChar(160)

  /// Documento de identidad, subido por el propio profesional desde su
  /// enlace. Mismo bucket privado que la tarjeta; solo lo ve el equipo.
  identityDocumentUrl String? @map("identity_document_url") @db.VarChar(500)
  /// El respaldo de la cédula. Opcional: un PDF con ambas caras no lo necesita.
  identityDocumentBackUrl String? @map("identity_document_back_url") @db.VarChar(500)
  /// Cuándo envió sus documentos por el enlace. Es lo que separa "por
  /// notificar" de "pendiente de aprobación" en la pantalla de verificaciones.
  documentsSubmittedAt DateTime? @map("documents_submitted_at") @db.Timestamptz(3)
  populations                 String[]
  modality                    Modality
  travelsTo                   String?                 @map("travels_to") @db.VarChar(200)

  status         ProfessionalStatus @default(PENDIENTE_VALIDACION)
  /// Cuántos acompañamientos simultáneos acepta.
  maxActiveCases Int                @default(3) @map("max_active_cases")
  /// Notas internas del equipo. Nunca salen al profesional ni al agendador.
  notes          String?            @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  assignments  CaseAssignment[]
  rules        AvailabilityRule[]
  exceptions   AvailabilityException[]
  appointments Appointment[]

  @@index([status])
  @@index([city])
  @@index([deletedAt])
  @@map("professionals")
}

model Patient {
  id               String  @id @default(uuid()) @db.Uuid
  /// Solicitud de la que nació.
  supportRequestId String? @unique @map("support_request_id") @db.Uuid

  fullName String  @map("full_name") @db.VarChar(160)
  phone    String  @db.VarChar(40)
  email    String? @db.VarChar(160)
  city     String  @db.VarChar(160)

  forWhom      ForWhom? @map("for_whom")
  isMinor      Boolean  @default(false) @map("is_minor")
  contactName  String?  @map("contact_name") @db.VarChar(160)
  relationship String?  @db.VarChar(120)

  preferredContact  PreferredContact?  @map("preferred_contact")
  preferredModality PreferredModality? @map("preferred_modality")
  /// Dias y franjas en que puede. Es lo que se cruza con la disponibilidad del
  /// profesional para encontrar un hueco comun.
  availableDays     Weekday[]          @map("available_days")
  availableSlots    DaySlot[]          @map("available_slots")

  status   PatientStatus @default(NUEVO)
  /// La define quien admite la solicitud. Es obligatoria en el formulario de
  /// admision; el valor por defecto solo existe para las filas anteriores a
  /// este campo.
  priority CasePriority  @default(MEDIA)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  assignments  CaseAssignment[]
  appointments Appointment[]
  notes        PatientNote[]
  feedbacks    PatientFeedback[]

  @@index([status])
  @@index([status, priority])
  @@index([city])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("patients")
}

/// Notas de seguimiento del equipo coordinador/agendador sobre la persona.
model PatientNote {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  note        String   @db.VarChar(2000)
  authorName  String   @map("author_name") @db.VarChar(160)
  authorEmail String   @map("author_email") @db.VarChar(160)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([patientId, createdAt])
  @@map("patient_notes")
}

/// Quién acompaña a quién, durante qué periodo.
/// Distinta de la cita: un caso tiene muchas sesiones.
/// Un paciente solo puede tener UNA asignación activa a la vez; esa regla la
/// impone un índice único parcial que vive en la migración SQL.
model CaseAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  patientId      String       @map("patient_id") @db.Uuid
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Nace como PROPUESTA: proponerle un caso a alguien no es asignárselo.
  status      AssignmentStatus @default(PROPUESTA)
  startedAt   DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime?        @map("ended_at") @db.Timestamptz(3)
  closeReason String?          @map("close_reason") @db.VarChar(300)

  // --- La negociación ---

  /// Cuándo respondió el profesional, sea que aceptara o no.
  respondedAt        DateTime? @map("responded_at") @db.Timestamptz(3)
  /// Los días y franjas en los que dijo que puede, puestos por él mismo desde
  /// el enlace de su caso. No los transcribe nadie: el dato es suyo.
  acceptedDays       Weekday[] @map("accepted_days")
  acceptedSlots      DaySlot[] @map("accepted_slots")
  /// El matiz que no cabe en días y franjas: "después de las 4 mejor".
  availabilityNote   String?   @map("availability_note") @db.VarChar(600)
  /// Por qué no pudo. Es lo que permite saber si el problema es de la red
  /// —siempre los mismos días, siempre la misma ciudad— o del caso.
  declineReason      String?   @map("decline_reason") @db.VarChar(300)
  /// Cuándo la persona acompañada confirmó el horario.
  patientConfirmedAt DateTime? @map("patient_confirmed_at") @db.Timestamptz(3)

  createdById String? @map("created_by_id") @db.Uuid
  survey      ClosureSurvey?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  appointments Appointment[]
  reports      CaseReport[]
  feedbacks    PatientFeedback[]

  @@index([professionalId, status])
  @@index([patientId, status])
  @@map("case_assignments")
}

// ===========================================================================
// Fase 2 — agenda
// ===========================================================================

/// Qué pasó cuando el profesional intentó contactar a la persona asignada.
/// Lo reporta él mismo desde el enlace del caso, sin cuenta en el portal.
enum CaseOutcome {
  /// Hablamos y quedamos en una cita.
  CITA_ACORDADA
  /// Ya la acompañé.
  YA_ATENDIDA
  /// La busqué y no contesta.
  NO_CONTESTA
  /// El numero o el correo no corresponden.
  DATOS_ERRADOS
  /// No quiere el acompanamiento o ya no lo necesita.
  NO_QUIERE
  /// Sigo intentando contactarla.
  SIGO_INTENTANDO
  /// Teniamos sesion y no se presento. Distinto de NO_CONTESTA: aqui SI
  /// habia cita, y para coordinacion son dos conversaciones diferentes.
  NO_ASISTIO
  OTRO
}

enum AppointmentStatus {
  PROGRAMADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  NO_ASISTIO
  REPROGRAMADA
}

/// Franja recurrente de disponibilidad.
/// Las horas se guardan como minutos desde medianoche EN HORA DE BOGOTÁ, no
/// como timestamps: una regla es "los martes de 2 a 6", no un instante.
model AvailabilityRule {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  weekday     Weekday
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  modality    Modality @default(AMBAS)
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([professionalId, weekday])
  @@map("availability_rules")
}

/// Bloqueo puntual: vacaciones, viaje, imprevisto. Gana sobre las reglas.
model AvailabilityException {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String?  @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([professionalId, startsAt])
  @@map("availability_exceptions")
}

/// Reporte del profesional sobre su asignación.
///
/// Quien acompaña no tiene cuenta en el portal: entra por el enlace del caso
/// y con eso mismo puede contar qué pasó. Sin esto, quien coordina se entera
/// del estado de un caso solo si llama y pregunta.
///
/// IMPORTANTE: aquí NO se guarda nada de lo que se habló en la sesión. La red
/// decidió no almacenar contenido clínico, y este formulario es solo sobre la
/// logística del contacto: si se logró, cuándo quedaron y qué estorbó.
///
/// Es una bitácora: se añaden reportes, no se corrigen. "No contesta" el
/// lunes y "cita acordada" el jueves son dos hechos, no una correccion del
/// primero.
/// Lo que el profesional cree que sigue despues de una sesion hecha. Es LA
/// pregunta que le permite a coordinacion decidir si agenda otra o cierra el
/// caso sin llamar a nadie; sin esto, "ya la acompane" no decia si termino.
enum CaseFollowUp {
  /// Necesita mas sesiones.
  NECESITA_MAS
  /// Con esta fue suficiente.
  SUFICIENTE
  /// Todavia no lo se.
  NO_SABE
}

/// Lo que respondió la persona en la encuesta breve tras el cierre.
enum EncuestaAyuda {
  SI
  ALGO
  NO
}

/// La encuesta breve que se le ofrece a la persona al cerrar su caso. Es el
/// único dato de resultado que la red tiene: dos preguntas, opcional, por
/// enlace con token. Una por asignación cerrada.
model ClosureSurvey {
  id           String         @id @default(uuid()) @db.Uuid
  assignmentId String         @unique @map("assignment_id") @db.Uuid
  assignment   CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  /// ¿Te sirvió el acompañamiento?
  helped         EncuestaAyuda
  /// ¿Se lo recomendarías a alguien que lo necesite?
  wouldRecommend Boolean       @map("would_recommend")
  /// Algo más que quiera decir. Opcional y corto.
  comment        String?       @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("closure_surveys")
}

/// Retroalimentación post-sesión de la persona acompañada.
model PatientFeedback {
  id           String          @id @default(uuid()) @db.Uuid
  patientId    String          @map("patient_id") @db.Uuid
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignmentId String?         @map("assignment_id") @db.Uuid
  assignment   CaseAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  /// ¿Cómo te sentiste en la sesión?
  howFelt              String   @map("how_felt") @db.VarChar(40)
  /// ¿El profesional fue puntual y te brindó un trato respetuoso y empático?
  respectfulTreatment  String?  @map("respectful_treatment") @db.VarChar(40)
  /// ¿Sientes que la sesión te dio claridad, alivio o herramientas para tu situación?
  gotTools             String?  @map("got_tools") @db.VarChar(40)
  /// ¿La comunicación (llamada / videollamada / presencial) funcionó sin problemas?
  sessionQuality       String?  @map("session_quality") @db.VarChar(40)
  /// ¿Deseas continuar tu acompañamiento con este mismo profesional?
  wantsToContinue      String   @map("wants_to_continue") @db.VarChar(40)
  /// Comentario o retroalimentación libre
  comment              String?  @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([patientId, createdAt])
  @@index([assignmentId, createdAt])
  @@map("patient_feedbacks")
}

model CaseReport {
  id           String         @id @default(uuid()) @db.Uuid
  assignmentId String         @map("assignment_id") @db.Uuid
  assignment   CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  outcome  CaseOutcome
  /// Solo cuando hubo o habrá encuentro.
  modality Modality?
  /// Cuándo quedaron, si quedaron. La hora la escribe el profesional.
  meetsAt  DateTime?   @map("meets_at") @db.Timestamptz(3)

  /// Qué estorbó para contactarla. Es lo que permite a la coordinación
  /// intervenir: un numero mal digitado, una zona sin señal, un horario imposible.
  contactDifficulties String? @map("contact_difficulties") @db.VarChar(600)
  /// En qué quedó, en una línea. NO es para contenido de la sesión.
  notes               String? @db.VarChar(1000)

  /// Qué sigue, cuando la sesión ya se hizo. Nulo en los demás resultados.
  followUp CaseFollowUp? @map("follow_up")

  /// Quién lo reportó. No hay sesión: el correo sale del token del enlace.
  reportedByEmail String   @map("reported_by_email") @db.VarChar(160)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([assignmentId, createdAt])
  @@map("case_reports")
}

/// Una sesión.
///
/// Reglas que impone la base de datos (ver la migración SQL):
///   · dura al menos 45 minutos
///   · deja `bufferMinutes` de descanso después, y en ese hueco no cabe otra
///   · dos citas vivas del mismo profesional no pueden solaparse
///   · dos citas vivas del mismo paciente tampoco
model Appointment {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  patientId      String       @map("patient_id") @db.Uuid
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  caseAssignmentId String?         @map("case_assignment_id") @db.Uuid
  caseAssignment   CaseAssignment? @relation(fields: [caseAssignmentId], references: [id], onDelete: SetNull)

  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(3)
  /// Descanso obligatorio después de la sesión.
  bufferMinutes Int       @default(30) @map("buffer_minutes")
  /// La calcula un disparador: `endsAt + bufferMinutes`. Es la columna sobre la
  /// que actúa la restricción de exclusión. No la escribas desde la aplicación.
  blocksUntil   DateTime? @map("blocks_until") @db.Timestamptz(3)

  modality Modality
  status   AppointmentStatus @default(PROGRAMADA)

  /// Enlace de la videollamada para citas virtuales (auto-generado o Meet/Zoom manual).
  meetingUrl      String? @map("meeting_url") @db.VarChar(500)
  meetingProvider String? @default("AUTO") @map("meeting_provider") @db.VarChar(50)

  /// Telemetría de la sesión virtual (clics, ingresos y duración).
  patientFirstJoinedAt      DateTime? @map("patient_first_joined_at") @db.Timestamptz(3)
  professionalFirstJoinedAt DateTime? @map("professional_first_joined_at") @db.Timestamptz(3)
  totalCallDurationSeconds  Int       @default(0) @map("total_call_duration_seconds")
  accessLogs                MeetingAccessLog[]

  consentSigned            Boolean   @default(false) @map("consent_signed")
  consentSignedDocumentUrl String?   @map("consent_signed_document_url") @db.VarChar(500)
  consentSignedAt          DateTime? @map("consent_signed_at") @db.Timestamptz(3)

  /// Al reprogramar, la cita no se edita: se cierra y apunta a la nueva.
  rescheduledToId String?      @unique @map("rescheduled_to_id") @db.Uuid
  rescheduledTo   Appointment? @relation("Reprogramacion", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment? @relation("Reprogramacion")

  cancelReason  String? @map("cancel_reason") @db.VarChar(300)
  cancelledById String? @map("cancelled_by_id") @db.Uuid
  createdById   String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

enum MeetingParticipantRole {
  PACIENTE
  PROFESIONAL
  COORDINACION
  INVITADO
}

/// Registro de acceso y telemetría de una sala de videollamada.
model MeetingAccessLog {
  id              String                 @id @default(uuid()) @db.Uuid
  appointmentId   String                 @map("appointment_id") @db.Uuid
  appointment     Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  role            MeetingParticipantRole @default(PACIENTE)
  participantName String?                @map("participant_name") @db.VarChar(160)
  joinedAt        DateTime               @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastPingAt      DateTime               @default(now()) @map("last_ping_at") @db.Timestamptz(3)
  durationSeconds Int                    @default(0) @map("duration_seconds")
  ipAddress       String?                @map("ip_address") @db.VarChar(100)
  userAgent       String?                @map("user_agent") @db.VarChar(300)

  @@index([appointmentId])
  @@index([role])
  @@index([joinedAt])
  @@map("meeting_access_logs")
}

// ===========================================================================
// Tamizaje previo a la admisión
// ===========================================================================

/// Respuestas de tres pasos. Van en enum y no en texto porque son lo que
/// alimenta el cálculo de la prioridad.
enum TriageDegree {
  SI
  MAS_O_MENOS
  NO
}

enum TriageCapacity {
  SI
  CON_DIFICULTAD
  NO
}

enum TriageUrgency {
  HOY
  ESTA_SEMANA
  PUEDO_ESPERAR
}

/// Lo que la persona respondió antes de que la admitieran.
///
/// Existe porque elegir prioridad al admitir se hacía con lo único que trae el
/// formulario público —nombre, ciudad y cuándo puede—, que no dice nada de
/// cómo está hoy. Así la prioridad acababa siendo MEDIA casi siempre y la cola
/// se ordenaba por fecha de llegada, que es justo lo que la prioridad venía a
/// evitar.
///
/// Es una bitácora, igual que `CaseReport`: se añade, no se corrige. Si alguien
/// responde otra vez porque su situación cambió, son dos hechos con su fecha,
/// no una corrección del primero.
///
/// Son datos de SALUD. Llevan su propia autorización, aparte de la del
/// formulario, y no salen nunca en un correo: el aviso lleva un enlace.
model TriageResponse {
  id               String         @id @default(uuid()) @db.Uuid
  supportRequestId String         @map("support_request_id") @db.Uuid
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  /// 1. ¿Está en un lugar seguro y tiene lo básico?
  safePlace        Boolean        @map("safe_place")
  /// 2. Del 1 al 5, qué tan mal la está pasando. La base exige que esté en rango.
  distress         Int
  /// 3. ¿Ha podido dormir y comer?
  sleepAndEat      TriageDegree   @map("sleep_and_eat")
  /// 4. ¿Puede con sus cosas del día?
  dailyFunction    TriageCapacity @map("daily_function")
  /// 5. ¿Tiene cerca a alguien que la acompañe?
  hasSupport       Boolean        @map("has_support")
  /// 6. Pensamientos de hacerse daño. Esta sola respuesta manda el caso a ALTA.
  selfHarmThoughts Boolean        @map("self_harm_thoughts")
  /// 7. Qué tan pronto siente que necesita hablar con alguien.
  howSoon          TriageUrgency  @map("how_soon")

  /// 8, 9 y 10. Cuándo puede y cómo lo prefiere.
  ///
  /// Esto ya se preguntaba en el formulario público, pero como opcional, y en
  /// la práctica no lo llenaba nadie: la propuesta le llegaba al profesional
  /// sin más dato que la ciudad. Aquí sí lo responde, porque ya está
  /// contestando y le cuesta dos toques más.
  ///
  /// Vive en el tamizaje y NO se escribe sobre la solicitud: esa es el
  /// registro de lo que la persona envió y no se edita nunca. De aquí pasa a
  /// la ficha del paciente, que es la que sí se administra.
  availableDays     Weekday[]          @map("available_days")
  availableSlots    DaySlot[]          @map("available_slots")
  preferredModality PreferredModality? @map("preferred_modality")

  /// La prioridad que sale de esas respuestas.
  ///
  /// Se GUARDA en vez de recalcularse al mostrarla: si mañana se afinan las
  /// reglas, hay que poder seguir viendo con qué criterio se admitió cada caso.
  suggestedPriority CasePriority @map("suggested_priority")
  /// Por qué salió esa prioridad, en frases listas para mostrar en el portal.
  reasons           String[]

  /// Autorización propia, porque esto es dato de salud.
  consentVersion       String  @map("consent_version") @db.VarChar(20)
  sensitiveDataConsent Boolean @default(true) @map("sensitive_data_consent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([supportRequestId, createdAt])
  @@map("triage_responses")
}

// ===========================================================================
// Centro de Mando Operativo — Líderes Comunitarios y Catálogo de Necesidades
// ===========================================================================

/// Catálogo dinámico administrable de necesidades de la comunidad.
model NeedCategory {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(40) // 'PSICOLOGICA' | 'RECURSO'
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(300)
  active      Boolean  @default(true)
  order       Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leaders CommunityLeaderNeed[]

  @@index([type, active])
  @@map("need_categories")
}

/// Perfil de Líder Comunitario y territorio a su cargo.
model CommunityLeader {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(160)
  phone              String    @db.VarChar(40)
  email              String?   @db.VarChar(160)
  territory          String    @db.VarChar(200)
  beneficiariesCount Int       @default(0) @map("beneficiaries_count")
  status             String    @default("ACTIVO") @db.VarChar(40) // 'ACTIVO' | 'EN_SEGUIMIENTO' | 'ATENDIDO' | 'INACTIVO'

  lastContactAt      DateTime? @map("last_contact_at") @db.Timestamptz(3)
  nextAction         String?   @map("next_action") @db.VarChar(600)
  nextActionDate     DateTime? @map("next_action_date") @db.Timestamptz(3)
  notes              String?   @db.VarChar(2000)

  createdById        String?   @map("created_by_id") @db.Uuid
  createdBy          User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  needs              CommunityLeaderNeed[]
  contacts           CommunityLeaderContact[]

  @@index([status])
  @@index([territory])
  @@index([createdAt])
  @@map("community_leaders")
}

/// Relación entre líder y las necesidades de su comunidad.
model CommunityLeaderNeed {
  id        String          @id @default(uuid()) @db.Uuid
  leaderId  String          @map("leader_id") @db.Uuid
  leader    CommunityLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  needId    String          @map("need_id") @db.Uuid
  need      NeedCategory    @relation(fields: [needId], references: [id], onDelete: Cascade)

  details   String?         @db.VarChar(500)
  status    String          @default("PENDIENTE") @db.VarChar(40) // 'PENDIENTE' | 'EN_GESTION' | 'CUBIERTA'
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([leaderId, needId])
  @@index([leaderId])
  @@index([needId])
  @@map("community_leader_needs")
}

/// Bitácora de seguimiento / contactos realizados con el líder.
model CommunityLeaderContact {
  id                String          @id @default(uuid()) @db.Uuid
  leaderId          String          @map("leader_id") @db.Uuid
  leader            CommunityLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  contactedAt       DateTime        @default(now()) @map("contacted_at") @db.Timestamptz(3)
  contactedBy       String          @map("contacted_by") @db.VarChar(160)
  notes             String          @db.VarChar(2000)
  nextActionDefined String?         @map("next_action_defined") @db.VarChar(600)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([leaderId, contactedAt])
  @@map("community_leader_contacts")
}

// ===========================================================================
// Módulo de Tareas Internas — Voluntariado de Apoyo
//
// Los Collaborators ayudan con labores internas de la fundación:
// verificaciones de TP, gestión de agenda, diseño, etc.
// Son tareas que el coordinador crea y asigna; el voluntario acepta o rechaza
// por un enlace en su correo, sin necesitar cuenta en el portal.
// ===========================================================================

enum TaskStatus {
  /// Solo visible para el equipo. Aún no se asigna.
  BORRADOR
  /// Se puede asignar a voluntarios.
  ABIERTA
  /// Al menos un voluntario la aceptó y está trabajando.
  EN_PROGRESO
  /// El coordinador la cerró como hecha.
  COMPLETADA
  CANCELADA
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

enum TaskAssignmentStatus {
  /// Se envió el email; el voluntario aún no responde.
  INVITADO
  /// Confirmó por el link.
  ACEPTADO
  /// Declinó por el link.
  RECHAZADO
  /// El coordinador marcó que empezó a trabajar.
  EN_PROGRESO
  /// El coordinador lo marcó como terminado.
  COMPLETADO
  /// Venció el plazo sin respuesta.
  NO_RESPONDIO
}

/// Tarea interna que el coordinador crea y asigna a voluntarios.
model Task {
  id          String       @id @default(uuid()) @db.Uuid
  /// A qué área pertenece la tarea. Sirve para sugerir voluntarios compatibles.
  area        CollaboratorArea
  title       String       @db.VarChar(200)
  description String?      @db.VarChar(2000)
  /// Fecha límite opcional. Hay tareas sin plazo fijo.
  dueDate     DateTime?    @map("due_date") @db.Date
  /// Hora de inicio estimada (ej. "08:00")
  startTime   String?      @map("start_time") @db.VarChar(10)
  /// Hora de fin estimada (ej. "12:00")
  endTime     String?      @map("end_time") @db.VarChar(10)
  priority    TaskPriority @default(MEDIA)
  status      TaskStatus   @default(BORRADOR)
  /// Enlace a carpeta de Drive, documento o herramienta de trabajo (visible para el voluntario tras aceptar).
  materialsUrl String?      @map("materials_url") @db.VarChar(500)
  /// Instrucciones, links, materiales. Solo visible para el equipo.
  notes       String?      @db.VarChar(2000)
  /// Quién la creó. Desnormalizado para que el rastro sobreviva si se elimina la cuenta.
  createdByEmail String?   @map("created_by_email") @db.VarChar(160)

  assignments TaskAssignment[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt      @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")               @db.Timestamptz(3)

  @@index([status])
  @@index([area])
  @@index([dueDate])
  @@map("tasks")
}

/// Quién hace qué tarea.
model TaskAssignment {
  id             String               @id @default(uuid()) @db.Uuid
  taskId         String               @map("task_id") @db.Uuid
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  collaboratorId String               @map("collaborator_id") @db.Uuid
  collaborator   Collaborator         @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  status         TaskAssignmentStatus @default(INVITADO)
  /// Nota del coordinador para esta asignación específica.
  note           String?              @db.VarChar(500)
  /// Token de un solo uso para el link de confirmación del voluntario. Nunca sale de la base.
  confirmToken   String               @unique @map("confirm_token") @db.VarChar(500)
  /// Cuándo el voluntario respondió (sea aceptar o rechazar).
  respondedAt    DateTime?            @map("responded_at") @db.Timestamptz(3)
  /// Razón del rechazo, si la da.
  declineReason  String?              @map("decline_reason") @db.VarChar(300)
  /// Enlace entregado por el voluntario al terminar (ej. link de Drive con los artes o reportes).
  completionUrl  String?              @map("completion_url") @db.VarChar(500)
  /// Comentario o reporte de entrega del voluntario.
  completionNote String?              @map("completion_note") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz(3)

  /// Un voluntario solo puede tener una asignación por tarea.
  @@unique([taskId, collaboratorId])
  @@index([collaboratorId, status])
  @@index([confirmToken])
  @@map("task_assignments")
}

// ===========================================================================
// Módulo de Parametrización y Configuración del Sistema
//
// Permite a la coordinación y administración editar dinámicamente:
// 1. Mensajes y plantillas de WhatsApp con variables {nombre}, {enlace}, etc.
// 2. Plantillas de correos electrónicos.
// 3. Parámetros operativos (duraciones, SLAs, descansos, enlaces institucionales).
// ===========================================================================

enum SettingCategory {
  MENSAJE_WHATSAPP
  PLANTILLA_CORREO
  PARAMETRO_GENERAL
}

model SystemSetting {
  id             String          @id @default(uuid()) @db.Uuid
  key            String          @unique @db.VarChar(100)
  category       SettingCategory
  name           String          @db.VarChar(200)
  description    String?         @db.VarChar(500)
  /// Contenido de la plantilla o valor del parámetro
  value          String          @db.Text
  /// Valor de fábrica original para poder restablecer
  defaultValue   String          @map("default_value") @db.Text
  /// Lista de variables permitidas en la plantilla (ej. ["nombre", "fecha", "enlace"])
  variables      String[]        @default([])
  /// Tipo de dato: TEXTO, NUMERO, BOOLEANO, JSON
  dataType       String          @default("TEXTO") @map("data_type") @db.VarChar(30)
  updatedByEmail String?         @map("updated_by_email") @db.VarChar(160)

  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt      @map("updated_at") @db.Timestamptz(3)

  @@index([category])
  @@index([key])
  @@map("system_settings")
}
