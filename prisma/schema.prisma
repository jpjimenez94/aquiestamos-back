// ---------------------------------------------------------------------------
// Aquí Estamos — capa MODELO (M de MVC)
// Motor: PostgreSQL (Railway)
//
// Convenciones:
//   · Todas las fechas van en `timestamptz`: se guardan en UTC y se muestran en
//     America/Bogota. Una agenda con `timestamp` sin zona acaba con citas a la
//     hora equivocada en cuanto alguien viaja o el servidor cambia de región.
//   · Nada se borra en duro. `deletedAt` marca el registro como eliminado y una
//     política de retención decide cuándo se purga de verdad.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Acceso al portal
// ===========================================================================

/// Quién puede entrar y qué puede hacer. El detalle de cada permiso vive en
/// `src/auth/permissions.js`, no aquí.
enum UserRole {
  /// Administrador general: todo, incluido crear usuarios y ver la auditoría.
  ADMIN
  /// Voluntario digital: consulta y agenda citas. No edita datos maestros.
  AGENDADOR
  /// Profesional de la red: solo consulta sus propias asignaciones.
  PROFESIONAL
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(160)
  name               String    @db.VarChar(160)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  active             Boolean   @default(true)
  /// Las cuentas las crea un administrador; la persona cambia la clave al entrar.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  sessions     Session[]
  auditLogs    AuditLog[]
  professional Professional?

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Sesión abierta. Se guarda el hash del token, nunca el token: si se filtra la
/// base, lo robado no sirve para entrar.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  ip        String?   @db.VarChar(60)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rastro de lo que pasa con datos sensibles. Solo se inserta: nadie edita ni
/// borra filas de esta tabla.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Desnormalizado a propósito: el rastro debe seguir siendo legible aunque la
  /// cuenta que lo generó desaparezca.
  actorEmail String?  @map("actor_email") @db.VarChar(160)
  action     String   @db.VarChar(60)
  entity     String   @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ===========================================================================
// Formularios públicos (admisión)
// ===========================================================================

/// Años de ejercicio profesional
enum YearsExperience {
  MENOS_DE_1
  ENTRE_1_Y_3
  ENTRE_3_Y_5
  MAS_DE_5
}

/// Horas semanales que puede dedicar. Cada sesión son 45 minutos más 30 de descanso.
enum WeeklyHours {
  ENTRE_1_Y_3
  ENTRE_4_Y_6
  MAS_DE_6
  VARIABLE
}

/// Día de la semana en que hay disponibilidad
enum Weekday {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/// Franja del día. Mañana 8-12, tarde 12-18, noche 18-21 (hora de Bogotá).
enum DaySlot {
  MANANA
  TARDE
  NOCHE
}

/// Para quién se pide el acompañamiento
enum ForWhom {
  PARA_MI
  PARA_OTRA_PERSONA
}

/// Canal preferido de contacto
enum PreferredContact {
  WHATSAPP
  LLAMADA
  CORREO
}

/// Modalidad que prefiere quien solicita
enum PreferredModality {
  PRESENCIAL
  VIRTUAL
  INDIFERENTE
}

/// Experiencia previa en atención en crisis / primeros auxilios psicológicos
enum CrisisExperience {
  SI
  NO
  FORMACION_POCA_PRACTICA
  SIN_FORMACION_DISPONIBLE_APRENDER
}

/// Modalidad en la que puede brindar acompañamiento
enum Modality {
  PRESENCIAL
  VIRTUAL
  AMBAS
}

/// Estado de vacunación contra la fiebre amarilla
enum YellowFeverStatus {
  SI
  NO
  CITA_AGENDADA
}

/// Estado de la tarjeta profesional
enum ProfessionalCardStatus {
  SI
  EN_TRAMITE
  ESTUDIANTE
}

/// Estado interno del registro dentro del proceso de la red
enum SubmissionStatus {
  NUEVO
  EN_REVISION
  CONTACTADO
  ACTIVO
  DESCARTADO
}

/// Areas del voluntariado que no da acompanamiento psicologico.
/// Es un enum y no texto libre porque es con lo que se filtra el directorio.
enum CollaboratorArea {
  SALUD
  SOCIAL_LEGAL_EDUCATIVO
  OPERACION_LOGISTICA
  COMUNICACION_TECNOLOGIA
  GESTION_PROYECTOS
  OTRA
}

/// Profesional que se postula a la red ("Quiero ser parte").
/// Es el registro de lo que la persona envió: no se edita.
model Volunteer {
  id String @id @default(uuid()) @db.Uuid

  // --- Bloque 1: datos de contacto ---
  fullName String  @map("full_name") @db.VarChar(160)
  phone    String  @db.VarChar(40)
  email    String  @db.VarChar(160)
  /// Ciudad o municipio donde vive. Antes se llamaba `residence`.
  city     String? @db.VarChar(160)

  // --- Bloque 2: perfil profesional ---
  /// Profesion, en campo aparte para poder filtrar por ella.
  profession         String?                @db.VarChar(160)
  /// Especializaciones, maestrias o cursos. Texto libre.
  additionalTraining String?                @map("additional_training") @db.VarChar(400)
  yearsExperience    YearsExperience?       @map("years_experience")
  professionalCard   ProfessionalCardStatus @map("professional_card")
  populations        String[]               @map("populations")
  populationOther    String?                @map("population_other") @db.VarChar(200)
  crisisExperience   CrisisExperience       @map("crisis_experience")

  // --- Bloque 3: disponibilidad ---
  modality           Modality
  availableToTravel  String?            @map("available_to_travel") @db.VarChar(200)
  /// Que dias puede. Alimenta directamente las franjas de la agenda.
  availableDays      Weekday[]          @map("available_days")
  availableSlots     DaySlot[]          @map("available_slots")
  weeklyHours        WeeklyHours?       @map("weekly_hours")
  /// Solo se pregunta a quien puede acompanar de forma presencial.
  yellowFeverVaccine YellowFeverStatus? @map("yellow_fever_vaccine")

  // --- Bloque 4: autorizaciones ---
  /// Que version del texto de autorizacion acepto. Sin esto, una autorizacion
  /// no se puede probar cuando el texto cambie.
  consentVersion        String? @map("consent_version") @db.VarChar(20)
  dataConsent           Boolean @map("data_consent")
  /// Solo aplica si entrego el dato de vacunacion, que es dato de salud.
  sensitiveDataConsent  Boolean @default(false) @map("sensitive_data_consent")
  communicationsConsent Boolean @default(false) @map("communications_consent")

  // --- Heredados de la primera version del formulario ---
  /// @deprecated Sustituido por `profession` y `additionalTraining`.
  training     String?  @db.VarChar(300)
  /// @deprecated Sustituido por `city`.
  residence    String?  @db.VarChar(160)
  /// @deprecated Sustituido por `weeklyHours`.
  availability String[]

  status    SubmissionStatus @default(NUEVO)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("volunteers")
}

/// Persona que solicita acompañamiento ("Atención Psicológica").
/// Igual que la postulación: es el registro de lo enviado, no se edita.
model SupportRequest {
  id String @id @default(uuid()) @db.Uuid

  // --- Bloque 1: para quien es ---
  forWhom      ForWhom? @map("for_whom")
  /// Solo si es para otra persona. Cambia quien debe autorizar el tratamiento.
  isMinor      Boolean? @map("is_minor")
  /// Parentesco o relacion con la persona acompanada.
  relationship String?  @db.VarChar(120)
  /// Nombre de quien llena el formulario, cuando no es la persona acompanada.
  contactName  String?  @map("contact_name") @db.VarChar(160)

  // --- Bloque 2: contacto ---
  /// Nombre de la persona que recibira el acompanamiento.
  name             String            @db.VarChar(160)
  phone            String            @db.VarChar(40)
  /// Opcional a proposito: la red trabaja por WhatsApp y no todo el mundo
  /// tiene o revisa correo.
  email            String?           @db.VarChar(160)
  preferredContact PreferredContact? @map("preferred_contact")
  /// Ciudad o municipio. Antes se llamaba `place`.
  city             String?           @db.VarChar(160)

  // --- Bloque 3: cuando y como ---
  preferredModality PreferredModality? @map("preferred_modality")
  availableDays     Weekday[]          @map("available_days")
  availableSlots    DaySlot[]          @map("available_slots")
  message           String?            @db.VarChar(1000)

  // --- Bloque 4: autorizaciones ---
  consentVersion        String? @map("consent_version") @db.VarChar(20)
  dataConsent           Boolean @map("data_consent")
  sensitiveDataConsent  Boolean @default(false) @map("sensitive_data_consent")
  /// Obligatoria cuando la persona acompanada es menor de edad.
  guardianConsent       Boolean @default(false) @map("guardian_consent")
  communicationsConsent Boolean @default(false) @map("communications_consent")

  // --- Heredados de la primera version del formulario ---
  /// @deprecated Sustituido por `city`.
  place        String? @db.VarChar(160)
  /// @deprecated Sustituido por `availableDays` y `availableSlots`.
  availability String? @db.VarChar(300)

  status    SubmissionStatus @default(NUEVO)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([deletedAt])
  @@map("support_requests")
}

// ===========================================================================
// Biblioteca pública
// ===========================================================================

model ResourceCategory {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique @db.VarChar(120)
  name      String     @db.VarChar(160)
  position  Int        @default(0)
  resources Resource[]

  @@map("resource_categories")
}

model Resource {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(160)
  title       String    @db.VarChar(200)
  description String    @db.VarChar(600)
  collection  String    @default("Cuentos infantiles") @db.VarChar(120)
  coverImage  String    @map("cover_image") @db.VarChar(300)
  fileUrl     String    @map("file_url") @db.VarChar(500)
  fileName    String    @map("file_name") @db.VarChar(200)
  icon        String    @default("sparkle") @db.VarChar(60)
  position    Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  categoryId String           @map("category_id") @db.Uuid
  category   ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([deletedAt])
  @@map("resources")
}

// ===========================================================================
// Fase 1 — entidades operativas
//
// El registro del formulario es lo que la persona envió y no se edita nunca.
// Estas entidades nacen a partir de él y evolucionan por su cuenta: son las
// que el equipo administra.
// ===========================================================================

/// Estado operativo del profesional. Dice si PUEDE recibir casos; cuántos lleva
/// se calcula contando asignaciones activas, nunca se guarda en un campo.
enum ProfessionalStatus {
  PENDIENTE_VALIDACION
  ACTIVO
  PAUSADO
  INACTIVO
}

enum PatientStatus {
  NUEVO
  EN_ADMISION
  ASIGNADO
  EN_ACOMPANAMIENTO
  CERRADO
}

enum AssignmentStatus {
  ACTIVA
  CERRADA
}

/// Voluntariado de otras disciplinas: quien apoya la respuesta sin dar
/// acompanamiento psicologico.
///
/// Va en tabla aparte de `Volunteer` a proposito. Una postulacion de
/// psicologia se aprueba y se convierte en `Professional`, que es a quien el
/// sistema le busca pacientes compatibles y le agenda citas. Un abogado o un
/// coordinador de logistica no entra en ese circuito: si compartieran tabla,
/// bastaria con olvidar un filtro en una consulta para que apareciera como
/// candidato para acompanar a alguien en crisis.
///
/// Esto es un directorio: se consulta y se llama. No tiene agenda.
model Collaborator {
  id String @id @default(uuid()) @db.Uuid

  // --- Bloque 1: contacto ---
  fullName String @map("full_name") @db.VarChar(160)
  phone    String @db.VarChar(40)
  email    String @db.VarChar(160)
  city     String @db.VarChar(160)

  // --- Bloque 2: que sabe hacer ---
  area             CollaboratorArea
  /// La disciplina concreta dentro del area. Es texto y no enum para poder
  /// anadir una sin migrar la base: el catalogo vive en el validador.
  discipline       String                  @db.VarChar(120)
  /// Que escribio si eligio "Otra".
  disciplineOther  String?                 @map("discipline_other") @db.VarChar(160)
  yearsExperience  YearsExperience?        @map("years_experience")
  /// Opcional: no todas las disciplinas tienen tarjeta profesional.
  professionalCard ProfessionalCardStatus? @map("professional_card")
  /// En que puede ayudar, con sus palabras. Es lo que mas sirve para decidir
  /// a quien llamar cuando aparece una necesidad concreta.
  skills           String?                 @db.VarChar(600)

  // --- Bloque 3: disponibilidad ---
  modality           Modality
  availableToTravel  String?            @map("available_to_travel") @db.VarChar(200)
  availableDays      Weekday[]          @map("available_days")
  availableSlots     DaySlot[]          @map("available_slots")
  weeklyHours        WeeklyHours?       @map("weekly_hours")
  /// Solo se pregunta a quien puede apoyar de forma presencial.
  yellowFeverVaccine YellowFeverStatus? @map("yellow_fever_vaccine")

  // --- Bloque 4: autorizaciones ---
  consentVersion        String? @map("consent_version") @db.VarChar(20)
  dataConsent           Boolean @map("data_consent")
  /// Solo aplica si entrego el dato de vacunacion, que es dato de salud.
  sensitiveDataConsent  Boolean @default(false) @map("sensitive_data_consent")
  communicationsConsent Boolean @default(false) @map("communications_consent")

  status    SubmissionStatus @default(NUEVO)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)

  @@index([email])
  @@index([area])
  @@index([city])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("collaborators")
}

model Professional {
  id          String  @id @default(uuid()) @db.Uuid
  /// Cuenta con la que entra al portal, si ya la tiene.
  userId      String? @unique @map("user_id") @db.Uuid
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Postulación de la que nació. Se conserva como prueba de lo que declaró.
  volunteerId String? @unique @map("volunteer_id") @db.Uuid

  fullName String @map("full_name") @db.VarChar(160)
  email    String @db.VarChar(160)
  phone    String @db.VarChar(40)
  city     String @db.VarChar(160)

  profession       String                  @db.VarChar(160)
  yearsExperience  YearsExperience?        @map("years_experience")
  professionalCard ProfessionalCardStatus? @map("professional_card")
  populations      String[]
  modality         Modality
  travelsTo        String?                 @map("travels_to") @db.VarChar(200)

  status         ProfessionalStatus @default(PENDIENTE_VALIDACION)
  /// Cuántos acompañamientos simultáneos acepta.
  maxActiveCases Int                @default(3) @map("max_active_cases")
  /// Notas internas del equipo. Nunca salen al profesional ni al agendador.
  notes          String?            @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  assignments  CaseAssignment[]
  rules        AvailabilityRule[]
  exceptions   AvailabilityException[]
  appointments Appointment[]

  @@index([status])
  @@index([city])
  @@index([deletedAt])
  @@map("professionals")
}

model Patient {
  id               String  @id @default(uuid()) @db.Uuid
  /// Solicitud de la que nació.
  supportRequestId String? @unique @map("support_request_id") @db.Uuid

  fullName String  @map("full_name") @db.VarChar(160)
  phone    String  @db.VarChar(40)
  email    String? @db.VarChar(160)
  city     String  @db.VarChar(160)

  forWhom      ForWhom? @map("for_whom")
  isMinor      Boolean  @default(false) @map("is_minor")
  contactName  String?  @map("contact_name") @db.VarChar(160)
  relationship String?  @db.VarChar(120)

  preferredContact  PreferredContact?  @map("preferred_contact")
  preferredModality PreferredModality? @map("preferred_modality")
  /// Dias y franjas en que puede. Es lo que se cruza con la disponibilidad del
  /// profesional para encontrar un hueco comun.
  availableDays     Weekday[]          @map("available_days")
  availableSlots    DaySlot[]          @map("available_slots")

  status PatientStatus @default(NUEVO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  assignments  CaseAssignment[]
  appointments Appointment[]

  @@index([status])
  @@index([city])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("patients")
}

/// Quién acompaña a quién, durante qué periodo.
/// Distinta de la cita: un caso tiene muchas sesiones.
/// Un paciente solo puede tener UNA asignación activa a la vez; esa regla la
/// impone un índice único parcial que vive en la migración SQL.
model CaseAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  patientId      String       @map("patient_id") @db.Uuid
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  status      AssignmentStatus @default(ACTIVA)
  startedAt   DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime?        @map("ended_at") @db.Timestamptz(3)
  closeReason String?          @map("close_reason") @db.VarChar(300)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  appointments Appointment[]
  reports      CaseReport[]

  @@index([professionalId, status])
  @@index([patientId, status])
  @@map("case_assignments")
}

// ===========================================================================
// Fase 2 — agenda
// ===========================================================================

/// Qué pasó cuando el profesional intentó contactar a la persona asignada.
/// Lo reporta él mismo desde el enlace del caso, sin cuenta en el portal.
enum CaseOutcome {
  /// Hablamos y quedamos en una cita.
  CITA_ACORDADA
  /// Ya la acompañé.
  YA_ATENDIDA
  /// La busqué y no contesta.
  NO_CONTESTA
  /// El numero o el correo no corresponden.
  DATOS_ERRADOS
  /// No quiere el acompanamiento o ya no lo necesita.
  NO_QUIERE
  /// Sigo intentando contactarla.
  SIGO_INTENTANDO
  OTRO
}

enum AppointmentStatus {
  PROGRAMADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  NO_ASISTIO
  REPROGRAMADA
}

/// Franja recurrente de disponibilidad.
/// Las horas se guardan como minutos desde medianoche EN HORA DE BOGOTÁ, no
/// como timestamps: una regla es "los martes de 2 a 6", no un instante.
model AvailabilityRule {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  weekday     Weekday
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  modality    Modality @default(AMBAS)
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([professionalId, weekday])
  @@map("availability_rules")
}

/// Bloqueo puntual: vacaciones, viaje, imprevisto. Gana sobre las reglas.
model AvailabilityException {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String?  @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([professionalId, startsAt])
  @@map("availability_exceptions")
}

/// Reporte del profesional sobre su asignación.
///
/// Quien acompaña no tiene cuenta en el portal: entra por el enlace del caso
/// y con eso mismo puede contar qué pasó. Sin esto, quien coordina se entera
/// del estado de un caso solo si llama y pregunta.
///
/// IMPORTANTE: aquí NO se guarda nada de lo que se habló en la sesión. La red
/// decidió no almacenar contenido clínico, y este formulario es solo sobre la
/// logística del contacto: si se logró, cuándo quedaron y qué estorbó.
///
/// Es una bitácora: se añaden reportes, no se corrigen. "No contesta" el
/// lunes y "cita acordada" el jueves son dos hechos, no una correccion del
/// primero.
model CaseReport {
  id           String         @id @default(uuid()) @db.Uuid
  assignmentId String         @map("assignment_id") @db.Uuid
  assignment   CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  outcome  CaseOutcome
  /// Solo cuando hubo o habrá encuentro.
  modality Modality?
  /// Cuándo quedaron, si quedaron. La hora la escribe el profesional.
  meetsAt  DateTime?   @map("meets_at") @db.Timestamptz(3)

  /// Qué estorbó para contactarla. Es lo que permite a la coordinación
  /// intervenir: un numero mal digitado, una zona sin señal, un horario imposible.
  contactDifficulties String? @map("contact_difficulties") @db.VarChar(600)
  /// En qué quedó, en una línea. NO es para contenido de la sesión.
  notes               String? @db.VarChar(1000)

  /// Quién lo reportó. No hay sesión: el correo sale del token del enlace.
  reportedByEmail String   @map("reported_by_email") @db.VarChar(160)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([assignmentId, createdAt])
  @@map("case_reports")
}

/// Una sesión.
///
/// Reglas que impone la base de datos (ver la migración SQL):
///   · dura al menos 45 minutos
///   · deja `bufferMinutes` de descanso después, y en ese hueco no cabe otra
///   · dos citas vivas del mismo profesional no pueden solaparse
///   · dos citas vivas del mismo paciente tampoco
model Appointment {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  patientId      String       @map("patient_id") @db.Uuid
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  caseAssignmentId String?         @map("case_assignment_id") @db.Uuid
  caseAssignment   CaseAssignment? @relation(fields: [caseAssignmentId], references: [id], onDelete: SetNull)

  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(3)
  /// Descanso obligatorio después de la sesión.
  bufferMinutes Int       @default(30) @map("buffer_minutes")
  /// La calcula un disparador: `endsAt + bufferMinutes`. Es la columna sobre la
  /// que actúa la restricción de exclusión. No la escribas desde la aplicación.
  blocksUntil   DateTime? @map("blocks_until") @db.Timestamptz(3)

  modality Modality
  status   AppointmentStatus @default(PROGRAMADA)

  /// Al reprogramar, la cita no se edita: se cierra y apunta a la nueva.
  rescheduledToId String?      @unique @map("rescheduled_to_id") @db.Uuid
  rescheduledTo   Appointment? @relation("Reprogramacion", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment? @relation("Reprogramacion")

  cancelReason  String? @map("cancel_reason") @db.VarChar(300)
  cancelledById String? @map("cancelled_by_id") @db.Uuid
  createdById   String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}
